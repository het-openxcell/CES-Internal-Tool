{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DDRExtraction",
  "type": "object",
  "additionalProperties": false,
  "required": ["time_logs", "mud_records", "deviation_surveys", "bit_records", "metres_drilled", "hole_condition", "bha_components"],
  "properties": {
    "well_name": {"type": ["string", "null"]},
    "surface_location": {"type": ["string", "null"]},
    "time_logs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start_time", "end_time", "duration_hours", "activity"],
        "properties": {
          "start_time": {"type": "string"},
          "end_time": {"type": "string"},
          "duration_hours": {"type": "number"},
          "activity": {"type": "string"},
          "depth_md": {"type": ["number", "null"]},
          "comment": {"type": ["string", "null"]},
          "page_number": {"type": ["integer", "null"]}
        }
      }
    },
    "mud_records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["depth_md", "mud_weight"],
        "properties": {
          "depth_md": {"type": "number"},
          "mud_weight": {"type": "number"},
          "viscosity": {"type": ["number", "null"]},
          "ph": {"type": ["number", "null"]},
          "comment": {"type": ["string", "null"]}
        }
      }
    },
    "deviation_surveys": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["depth_md", "inclination", "azimuth"],
        "properties": {
          "depth_md": {"type": "number"},
          "inclination": {"type": "number"},
          "azimuth": {"type": "number"},
          "tvd": {"type": ["number", "null"]}
        }
      }
    },
    "bit_records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bit_number", "bit_size", "depth_in", "depth_out"],
        "properties": {
          "bit_number": {"type": "string"},
          "bit_size": {"type": "number"},
          "depth_in": {"type": "number"},
          "depth_out": {"type": "number"},
          "hours": {"type": ["number", "null"]},
          "comment": {"type": ["string", "null"]}
        }
      }
    },
    "metres_drilled": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from_depth", "to_depth"],
        "properties": {
          "from_depth": {"type": "number"},
          "to_depth": {"type": "number"},
          "drill_code": {"type": ["string", "null"]},
          "rpm": {"type": ["number", "null"]},
          "wob": {"type": ["number", "null"]}
        }
      }
    },
    "hole_condition": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "drag_up": {"type": ["number", "null"]},
          "drag_down": {"type": ["number", "null"]},
          "torque_at_bottom": {"type": ["number", "null"]},
          "kelly_down": {"type": ["number", "null"]},
          "weight_of_string": {"type": ["number", "null"]}
        }
      }
    },
    "bha_components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component"],
        "properties": {
          "component": {"type": "string"},
          "od": {"type": ["number", "null"]},
          "id": {"type": ["number", "null"]},
          "length": {"type": ["number", "null"]}
        }
      }
    }
  }
}
